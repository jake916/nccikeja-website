RESEND_API_KEY=
FORMS_EMAIL_FROM="New Covenant Church <forms@yourdomain.org>"
# Comma-separated inboxes. FORMS_EMAIL_TO is the default; the others override it per form.
FORMS_EMAIL_TO=
TESTIMONY_EMAIL_TO=
ACADEMY_EMAIL_TO=
CONNECT_EMAIL_TO=
PRAYER_EMAIL_TO=
EVENTS_EMAIL_TO=
